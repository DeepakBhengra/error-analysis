# Vite dev server (copy to web/.env.local and adjust)
# Host to bind — use 0.0.0.0 to reach the UI from other machines on your network.
VITE_DEV_HOST=127.0.0.1

# UI port (default 5173). Vite picks the next free port if busy unless VITE_DEV_STRICT_PORT=1.
VITE_DEV_PORT=5173

# Fail startup when VITE_DEV_PORT is already in use (optional).
# VITE_DEV_STRICT_PORT=1

# Backend API URL for /api proxy during npm run dev.
VITE_API_PROXY_TARGET=http://127.0.0.1:8010
