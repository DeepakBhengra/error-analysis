# Datadog credentials (never commit real values)
# Option A (recommended if you have a PAT/SAT): Personal or Service Access Token
DD_ACCESS_TOKEN=
# Option B: classic API key + Application key (used when DD_ACCESS_TOKEN is empty)
DD_API_KEY=your_api_key_here
DD_APP_KEY=your_application_key_here
DD_SITE=us5.datadoghq.com

# Optional defaults
DEFAULT_QUERY="G0D82"
DEFAULT_STORAGE_TIER=indexes
DEFAULT_SORT=-timestamp
DEFAULT_PAGE_LIMIT=50
CHECKOUT_SERVICE=AsyncOrderCreate,OrderCreate_v6*,OrderCreate_v2*
ORDER_CREATE_SERVICES=AsyncOrderCreate,OrderCreate_v6*,OrderCreate_v2*
# Prod Order Create hosts (reference / optional host filter)
ASYNC_ORDER_HOSTS=uschileai1401,uschileai1402,uschileai1403,uschileai1404

# Order Create Basic Auth (for build-order-curl; never commit real values)
# Also editable from the web Settings tab (PUT /api/settings).
ORDER_CREATE_USERNAME=
ORDER_CREATE_PASSWORD=
# Optional Cookie header (Postman session cookie)
ORDER_CREATE_COOKIE=

# Order Modify Basic Auth (api-test / api-qa1 regions; Settings tab)
ORDER_MODIFY_TEST_USERNAME=
ORDER_MODIFY_TEST_PASSWORD=
ORDER_MODIFY_QA1_USERNAME=
ORDER_MODIFY_QA1_PASSWORD=
ORDER_MODIFY_SERVICES=OrderModify_v6*

# Replay defaults (web Settings tab; Home uses these)
DEFAULT_ORDER_CREATE_TARGET=uat
DEFAULT_ORDER_MODIFY_TARGET=test
DEFAULT_REPLAY_MODE=one_up

# Inbound API key for POST /api/v1/order-curl (never commit real values)
ORDER_CURL_API_KEY=

# Legacy error code lookup service (click-to-lookup popup)
# Error Analysis calls http://127.0.0.1:8000 — start Legacy COBOL Error Scanner separately.
LOOKUP_API_URL=http://127.0.0.1:8000/api/v1/lookup
LOOKUP_API_KEY=cobolilapp
LOOKUP_APPLICATION_KEY=deepakcobolil88206
LOOKUP_SOURCE_ROOT=C:/Legacy-Error-Code-Mapper-ver1/samples
LOOKUP_RULES_PATH=C:/Legacy-Error-Code-Mapper-ver1/config/error_rules.json
LOOKUP_CORORA_MAPPINGS=C:/Legacy-Error-Code-Mapper-ver1/error_mapping_files
#
# ALSO required on the Legacy COBOL Error Scanner (port 8000) process itself:
# COBOL_EXTERNAL_API_KEY=...
# COBOL_EXTERNAL_APPLICATION_KEY=...
# Without these, the UI shows "External lookup API is not configured" (503).

# Application error logging (written under logs/ by default)
# ERROR_ANALYSIS_LOG_LEVEL=INFO
# ERROR_ANALYSIS_LOG_DIR=logs
